model ChatRoom {
  id         BigInt           @id @default(autoincrement())
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  code       String           @unique @default(uuid())
  name       String
  owner_id   BigInt?
  owner      Profile?         @relation("RoomOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  members    ChatRoomMember[]
  messages   ChatMessage[]

  @@schema("public")
}

model ChatRoomMember {
  id         BigInt   @id @default(autoincrement())
  room_id    BigInt
  room       ChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  profile_id BigInt
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  joined_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([room_id, profile_id])
  @@schema("public")
}

model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  room_id    BigInt
  room       ChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  profile_id BigInt
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([room_id, created_at])
  @@schema("public")
}

model FootballTeam {
  id                BigInt   @id @default(autoincrement())
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  owner_id          BigInt?
  owner             Profile? @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  name              String
  is_ai             Boolean  @default(false)
  default_formation String   @default("2-2-2")
  default_lineup    Json?
  budget            Int      @default(1000)
  players           FootballPlayer[]
  homeMatches       FootballMatch[] @relation("FootballHomeTeam")
  awayMatches       FootballMatch[] @relation("FootballAwayTeam")
  challengesSent    FootballChallenge[] @relation("ChallengerTeam")
  challengesReceived FootballChallenge[] @relation("OpponentTeam")
  listings          FootballPlayer[] @relation("ListedBy")

  @@schema("public")
}

model FootballPlayer {
  id             BigInt       @id @default(autoincrement())
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  team_id        BigInt?
  team           FootballTeam? @relation(fields: [team_id], references: [id], onDelete: Cascade)
  name           String
  position       String // GK | DEF | MID | FWD
  personality    String // FOCUSED | INCONSISTENT | RASH | OVERCONFIDENT | CLUTCH | LEADER
  price          Int? // set when this is an unsigned free agent on the transfer market
  listed_by_team_id BigInt? // set when a manager (not admin) has listed this player for sale
  listed_by         FootballTeam? @relation("ListedBy", fields: [listed_by_team_id], references: [id], onDelete: SetNull)
  level          Int          @default(1)
  xp             Int          @default(0)
  unspent_points Int          @default(0)
  finishing      Int          @default(0)
  trickery       Int          @default(0)
  timing         Int          @default(0)
  control        Int          @default(0)
  passing        Int          @default(0)
  vision         Int          @default(0)
  tackling       Int          @default(0)
  disruption     Int          @default(0)
  positioning    Int          @default(0)
  reflexes       Int          @default(0)
  handling       Int          @default(0)
  distribution   Int          @default(0)

  @@schema("public")
}

model FootballMatch {
  id                   BigInt               @id @default(autoincrement())
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?            @db.Timestamptz(6)
  home_team_id         BigInt
  home_team            FootballTeam         @relation("FootballHomeTeam", fields: [home_team_id], references: [id], onDelete: Cascade)
  away_team_id         BigInt
  away_team            FootballTeam         @relation("FootballAwayTeam", fields: [away_team_id], references: [id], onDelete: Cascade)
  status               String               @default("FIRST_HALF_PENDING")
  home_score           Int                  @default(0)
  away_score           Int                  @default(0)
  home_lineup          Json
  away_lineup          Json
  home_halftime_lineup Json?
  away_halftime_lineup Json?
  home_stamina         Json? // Record<playerId, 0-100> — snapshot as of the most recently simulated half
  away_stamina         Json?
  home_form            Json? // Record<playerId, 0-100> — this half's form roll
  away_form            Json?
  events               FootballMatchEvent[]
  challenges           FootballChallenge[]

  @@schema("public")
}

model FootballChallenge {
  id                 BigInt       @id @default(autoincrement())
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  challenger_team_id BigInt
  challenger_team    FootballTeam @relation("ChallengerTeam", fields: [challenger_team_id], references: [id], onDelete: Cascade)
  opponent_team_id   BigInt
  opponent_team      FootballTeam @relation("OpponentTeam", fields: [opponent_team_id], references: [id], onDelete: Cascade)
  status             String       @default("PENDING") // PENDING | ACCEPTED | DECLINED
  match_id           BigInt?
  match              FootballMatch? @relation(fields: [match_id], references: [id], onDelete: SetNull)

  @@schema("public")
}

model FootballMatchEvent {
  id            BigInt        @id @default(autoincrement())
  match_id      BigInt
  match         FootballMatch @relation(fields: [match_id], references: [id], onDelete: Cascade)
  sequence      Int
  minute        Int
  half          Int
  type          String
  description   String
  player_id     BigInt?
  position_data Json?

  @@index([match_id, sequence])
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LB_MemoryCards {
  id               BigInt   @id @default(autoincrement())
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  mps              Float    @db.Real
  score            Float    @db.Real
  time             String
  moves            Int?
  matches          Int?     @default(18)
  duration_seconds Int?
  emoji_set        String?
  player_id        BigInt
  Profile          Profile  @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  username       String?
  first_name     String?
  last_name      String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  avatar         String?
  id             BigInt           @id(map: "User_pkey") @default(autoincrement())
  auth_user_id   String?          @db.Uuid
  auth_email     String?          @db.VarChar
  is_admin       Boolean          @default(false)
  LB_MemoryCards LB_MemoryCards[]
  users          users?           @relation(fields: [auth_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownedRooms     ChatRoom[]       @relation("RoomOwner")
  roomMembership ChatRoomMember[]
  chatMessages   ChatMessage[]
  footballTeams  FootballTeam[]

  @@schema("public")
}

enum aal_level {
  aal1
  aal2
  aal3

  @@schema("auth")
}

enum code_challenge_method {
  s256
  plain

  @@schema("auth")
}

enum factor_status {
  unverified
  verified

  @@schema("auth")
}

enum factor_type {
  totp
  webauthn
  phone

  @@schema("auth")
}

enum oauth_authorization_status {
  pending
  approved
  denied
  expired

  @@schema("auth")
}

enum oauth_client_type {
  public
  confidential

  @@schema("auth")
}

enum oauth_registration_type {
  dynamic
  manual

  @@schema("auth")
}

enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}
